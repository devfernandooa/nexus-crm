rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função para verificar se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para verificar se é Super Admin via Custom Claim no token JWT
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superAdmin == true;
    }

    // Função para buscar o documento do usuário logado
    function getUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Função para buscar o empresaId do usuário logado
    function getEmpresaId() {
      return getUserDoc().empresaId;
    }

    // Função para buscar o role do usuário logado (normalizado em minúsculo)
    function getRole() {
      return getUserDoc().role.lower();
    }

    // --- REGRAS PARA EMPRESAS ---
    match /empresas/{empresaId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getEmpresaId() == empresaId);
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && getRole() == 'admin' && getEmpresaId() == empresaId);
      allow create: if isAuthenticated();
    }

    // --- REGRAS PARA USUÁRIOS ---
    match /usuarios/{userId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (getRole() == 'admin' && getEmpresaId() == resource.data.empresaId)
        )
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (getRole() == 'admin' && getEmpresaId() == resource.data.empresaId)
        )
      );
      allow create: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin() || (
        isAuthenticated() && getRole() == 'admin' && getEmpresaId() == resource.data.empresaId
      );
    }

    // --- REGRAS PARA CONVITES ---
    match /convites/{conviteId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAuthenticated() && getRole() == 'admin');
    }

    // --- REGRAS PARA DADOS OPERACIONAIS ---

    // CONTATOS: Usuários autenticados da mesma empresa (admin, vendedor, leitor)
    match /contatos/{docId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && getEmpresaId() == resource.data.empresaId);
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == request.resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
    }

    // SOLICITAÇÕES DE COMPRA / RECOMPRA (Alertas do Telegram / WhatsApp)
    match /solicitacoes_compra/{docId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor', 'leitor']
      );
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == request.resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
      allow delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() == 'admin'
      );
    }

    // NEGÓCIOS
    match /negocios/{docId} {
      // 1. Leitura: equipe autenticada da mesma empresa (permite checar negócios abertos ao assumir lead)
      allow read: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor', 'leitor']
      );

      // 2. Criação: Admin cria para a empresa; Vendedor cria atribuindo a si mesmo (responsavelId ou vendedorId)
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == request.resource.data.empresaId && (
          getRole() == 'admin' ||
          (
            getRole() == 'vendedor' && (
              request.resource.data.responsavelId == request.auth.uid ||
              request.resource.data.vendedorId == request.auth.uid
            )
          )
        )
      );

      // 3. Edição: Admin edita na empresa; Vendedor edita apenas os seus negócios
      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getEmpresaId() == request.resource.data.empresaId && (
          getRole() == 'admin' ||
          (
            getRole() == 'vendedor' &&
            (resource.data.responsavelId == request.auth.uid || resource.data.vendedorId == request.auth.uid) &&
            (request.resource.data.responsavelId == request.auth.uid || request.resource.data.vendedorId == request.auth.uid)
          )
        )
      );

      // 4. Exclusão: Admin exclui na empresa; Vendedor exclui apenas os seus negócios
      allow delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId && (
          getRole() == 'admin' ||
          (
            getRole() == 'vendedor' &&
            (resource.data.responsavelId == request.auth.uid || resource.data.vendedorId == request.auth.uid)
          )
        )
      );
    }

    // TAREFAS
    match /tarefas/{docId} {
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == request.resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
      allow read: if isSuperAdmin() || (isAuthenticated() && getEmpresaId() == resource.data.empresaId);
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
    }

    // PRODUTOS
    match /produtos/{docId} {
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == request.resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
      allow read: if isSuperAdmin() || (isAuthenticated() && getEmpresaId() == resource.data.empresaId);
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() &&
        getEmpresaId() == resource.data.empresaId &&
        getRole() in ['admin', 'vendedor']
      );
    }

    // --- COLEÇÕES TÉCNICAS / WHATSAPP ---
    match /whatsapp_sessoes/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /audit_logs/{docId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin();
    }
  }
}