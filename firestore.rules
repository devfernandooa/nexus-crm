rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para verificar se o usuário é Admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Função para verificar se o documento pertence à empresa do usuário
    function isSameEmpresa(empresaId) {
      return isAuthenticated() && request.auth.token.empresaId == empresaId;
    }

    // --- REGRAS PARA EMPRESAS ---
    match /empresas/{empresaId} {
      // Qualquer pessoa logada pode ler a própria empresa
      allow read: if isAuthenticated() && request.auth.token.empresaId == empresaId;
      // Apenas o Admin da empresa pode atualizar
      allow update: if isAdmin() && request.auth.token.empresaId == empresaId;
      // Apenas o Admin pode excluir (cuidado!)
      allow delete: if isAdmin() && request.auth.token.empresaId == empresaId;
      // Criação de empresa é feita no cadastro (sem estar logado ainda)
      allow create: if isAuthenticated(); 
    }

    // --- REGRAS PARA USUÁRIOS ---
    match /usuarios/{userId} {
      // O usuário pode ler o próprio perfil, ou o Admin pode ler os da mesma empresa
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // O usuário pode atualizar o próprio perfil, Admin pode atualizar qualquer um da empresa
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // O usuário pode criar o próprio perfil no cadastro
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Apenas Admin pode deletar um usuário
      allow delete: if isAdmin();
    }

    // --- REGRAS PARA CONVITES ---
    match /convites/{conviteId} {
      // O cadastro precisa ler o convite antes de estar logado
      allow read: if true; 
      // Apenas Admin pode criar/cancelar convites
      allow write: if isAdmin();
    }

    // --- REGRAS PARA DADOS OPERACIONAIS (Contatos, Negócios, Tarefas, Produtos) ---
    match /contatos/{docId} {
      allow read, write: if isAuthenticated() && isSameEmpresa(resource.data.empresaId);
    }
    match /negocios/{docId} {
      allow read, write: if isAuthenticated() && isSameEmpresa(resource.data.empresaId);
    }
    match /tarefas/{docId} {
      allow read, write: if isAuthenticated() && isSameEmpresa(resource.data.empresaId);
    }
    match /produtos/{docId} {
      allow read, write: if isAuthenticated() && isSameEmpresa(resource.data.empresaId);
    }
  }
}