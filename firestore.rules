rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função para buscar o empresaId do usuário logado
    function getEmpresaId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId;
    }

    // Função para buscar o role do usuário logado
    function getRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role;
    }

    // --- REGRAS PARA EMPRESAS ---
    match /empresas/{empresaId} {
      allow read: if isAuthenticated() && getEmpresaId() == empresaId;
      allow update, delete: if isAuthenticated() && getRole() == 'admin' && getEmpresaId() == empresaId;
      allow create: if isAuthenticated();
    }

    // --- REGRAS PARA USUÁRIOS ---
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || getRole() == 'admin');
      allow update: if isAuthenticated() && (request.auth.uid == userId || getRole() == 'admin');
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && getRole() == 'admin';
    }

    // --- REGRAS PARA CONVITES ---
    match /convites/{conviteId} {
      allow read: if true; // O cadastro precisa ler o convite antes de estar logado
      allow write: if isAuthenticated() && getRole() == 'admin';
    }

    // --- REGRAS PARA DADOS OPERACIONAIS ---
    match /contatos/{docId} {
      allow read, write: if isAuthenticated() && getEmpresaId() == resource.data.empresaId;
    }
    match /negocios/{docId} {
      allow read, write: if isAuthenticated() && getEmpresaId() == resource.data.empresaId;
    }
    match /tarefas/{docId} {
      allow read, write: if isAuthenticated() && getEmpresaId() == resource.data.empresaId;
    }
    match /produtos/{docId} {
      allow read, write: if isAuthenticated() && getEmpresaId() == resource.data.empresaId;
    }
  }
}